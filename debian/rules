#!/usr/bin/make -f
export PYBUILD_NAME = ksnip-pyqt6

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_clean:
	dh_auto_clean
	find ksnip_py tests_py tools -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
	find ksnip_py tests_py tools -type f -name '*.pyc' -delete 2>/dev/null || true

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	QT_QPA_PLATFORM=offscreen python3 -m pytest tests_py -q
endif

override_dh_installchangelogs:
	dh_installchangelogs -XCHANGELOG.md
