#!/usr/bin/make -f

%:
	dh $@ --with python3 --buildsystem=pybuild

# Skip tests during package build - PyQt6 is only a runtime dependency
# and not available in the build environment. Run tests in CI instead.
override_dh_auto_test:

# Ensure the executable is properly installed
override_dh_auto_install:
	dh_auto_install
	# The entry point is installed by setuptools via pyproject.toml
	# No additional steps needed

# Install desktop file, icons, metainfo, and man page
override_dh_install:
	dh_install
	# The desktop file and icons are installed via package-data in pyproject.toml
	# Man page is installed via debian/ksnip-pyqt6.1